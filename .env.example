# ──────────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/khatema"

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────
# JWT
# ──────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-32-char-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ──────────────────────────────────────────
# App
# ──────────────────────────────────────────
NODE_ENV="development"
BACKEND_PORT=3001
FRONTEND_URL="http://localhost:3000"

# ──────────────────────────────────────────
# Google OAuth
# Get credentials from: console.cloud.google.com → APIs & Services → Credentials
# ──────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# ──────────────────────────────────────────
# Email / SMTP (optional — logs to console if not set)
# ──────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ختمة <noreply@khatema.com>"
